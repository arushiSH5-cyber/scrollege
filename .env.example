# Copy to .env.local and fill in. .env.local is git-ignored.
ANTHROPIC_API_KEY=
# true = the whole app works with no keys (sample Photosynthesis deck)
DEMO_MODE=true

# Protect your key on a public link (all optional)
# AI_ACCESS_CODE=pick-a-secret   -> only links with ?code=pick-a-secret get real AI; others see the sample decks
# AI_DAILY_PER_PERSON=20         -> AI turns per visitor per day (a deck costs 3)
# AI_DAILY_TOTAL=300             -> AI turns per day for everyone together

# Natural voice for read-aloud (optional): https://play.cartesia.ai → API Keys
# CARTESIA_API_KEY=sk_car_...
# CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4   # default: "Skylar" (en-US); pick any voice id from play.cartesia.ai/voices
# TTS_DAILY_CHARS_PER_PERSON=2500
# TTS_DAILY_CHARS_TOTAL=15000
